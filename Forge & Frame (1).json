    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const deal = item.json;\n\n  let score = 100;\n\n  // Calculate days since last contact\n  const lastContact = deal.last_contact_date ? new Date(deal.last_contact_date) : null;\n  const today = new Date();\n  let daysSinceContact = 0;\n\n  if (lastContact) {\n    daysSinceContact = Math.floor((Number(today) - Number(lastContact)) / (1000 * 60 * 60 * 24));\n  }\n\n  // Deduct based on days since last contact\n  if (daysSinceContact >= 22) {\n    score -= 50;\n  } else if (daysSinceContact >= 15) {\n    score -= 35;\n  } else if (daysSinceContact >= 8) {\n    score -= 20;\n  }\n\n  // Adjust based on current stage\n  const stage = (deal.current_stage ?? \"\").toLowerCase();\n  if (stage === 'closed lost') {\n    score -= 60;\n  } else if (stage === 'ghosted') {\n    score -= 40;\n  } else if (stage === 'prospecting') {\n    score -= 5;\n  } else if (stage === 'negotiation') {\n    score += 5;\n  } else if (stage === 'closed won') {\n    score += 10;\n  }\n\n  // Adjust based on deal value\n  const dealValue = Number(deal.deal_value ?? 0);\n  if (dealValue > 15000) {\n    score += 5;\n  } else if (dealValue < 5000) {\n    score -= 10;\n  }\n\n  // Clamp score between 0 and 100\n  score = Math.max(0, Math.min(100, score));\n\n  // Assign health status\n  let health_status = '';\n  if (score >= 80) {\n    health_status = 'Healthy';\n  } else if (score >= 50) {\n    health_status = 'At Risk';\n  } else if (score >= 25) {\n    health_status = 'Stalled';\n  } else {\n    health_status = 'Dead';\n  }\n\n  // Format deal value as currency\n  const formatted_value = '$' + dealValue.toLocaleString('en-US', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  });\n\n  return {\n    json: {\n      deal_id: deal.deal_id,\n      channel: deal.channel,\n      rep_name: deal.rep_name,\n      deal_value: dealValue,\n      formatted_value: formatted_value,\n      current_stage: deal.current_stage,\n      last_contact_date: deal.last_contact_date,\n      days_in_stage: deal.days_in_stage,\n      days_since_contact: daysSinceContact,\n      notes: deal.notes,\n      normalized_at: deal.normalized_at,\n      health_score: score,\n      health_status: health_status\n    }\n  };\n});\n"
      },
