    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Read raw AI output from all possible field paths ──────────────────────────\nconst j = $input.item.json;\n\nconst rawResponse =\n  j?.message?.content\n  || j?.choices?.[0]?.message?.content\n  || j?.text\n  || j?.content\n  || j?.output\n  || j?.response\n  || \"\";\n\n// ── Pull pre-screened transaction fields from Node 5 ──────────────────────────\nconst node5 = $('Code - Pre-Screen for Edge Cases').item.json;\nconst transactionId   = node5.transactionId   || \"\";\nconst transactionDate = node5.transactionDate || \"\";\nconst vendorName      = node5.vendorName      || \"\";\nconst amount          = node5.amount          || 0;\nconst rawDescription  = node5.rawDescription  || \"\";\nconst currentLabel    = node5.currentLabel    || \"\";\nconst rowNumber       = node5.rowNumber       || \"\";\nconst auditFlag       = node5.auditFlag       || \"None\";\nconst requiresAudit   = node5.requiresAudit   || false;\n\n// ── Clean AI response ─────────────────────────────────────────────────────────\nlet cleanJson = rawResponse.trim();\ncleanJson = cleanJson\n  .replace(/^```(?:json)?\\s*/i, \"\")\n  .replace(/\\s*```$/, \"\")\n  .trim();\ncleanJson = cleanJson.replace(/\\\\n/g, \"\\n\");\n\n// ── Parse ─────────────────────────────────────────────────────────────────────\nlet parsed     = null;\nlet parseError = null;\n\ntry {\n  parsed = JSON.parse(cleanJson);\n} catch (e) {\n  parseError = e.message;\n}\n\n// ── Validate category ─────────────────────────────────────────────────────────\nconst validCategories = [\n  \"Professional Fees\",\n  \"Software/SaaS\",\n  \"Travel & Entertainment\",\n  \"Utilities\",\n  \"Payroll & Wages\",\n  \"Office Supplies\",\n  \"Marketing & Advertising\",\n  \"Bank Fees & Interest\",\n  \"Rent & Facilities\",\n  \"Uncategorized\"\n];\n\nlet category            = null;\nlet confidenceScore     = 0;\nlet reasoning           = \"\";\nlet alternativeCategory = null;\nlet categoryCode        = \"\";\n\nif (parsed) {\n  category = parsed.category || null;\n\n  // Validate category is one of the allowed values\n  if (!validCategories.includes(category)) {\n    parseError = `Invalid category returned: \"${category}\"`;\n    parsed = null;\n    category = null;\n  } else {\n    confidenceScore     = parseInt(parsed.confidenceScore) || 0;\n    reasoning           = parsed.reasoning           || \"\";\n    alternativeCategory = parsed.alternativeCategory || null;\n    categoryCode        = parsed.categoryCode        || \"\";\n\n    // Enforce confidence cap for missing descriptions\n    if (node5.descriptionMissing && confidenceScore > 70) {\n      confidenceScore = 70;\n      reasoning = \"[Confidence capped at 70 — description was missing] \" + reasoning;\n    }\n\n    // Force low confidence if audit flag is present and large amount\n    if (node5.isLargeAmount && confidenceScore > 85) {\n      confidenceScore = 85;\n      reasoning = \"[Confidence capped at 85 — large amount requires review] \" + reasoning;\n    }\n  }\n}\n\n// ── Determine final status ────────────────────────────────────────────────────\n// Even if confidence is high, large amounts or missing descriptions\n// should never be auto-finalized\nconst isHighConfidence = parsed !== null\n  && confidenceScore >= 85\n  && !requiresAudit;\n\nreturn {\n  parseSuccess:       parsed !== null,\n  parseError:         parseError || null,\n  rawAiResponse:      rawResponse,\n  category,\n  categoryCode,\n  confidenceScore,\n  reasoning,\n  alternativeCategory,\n  isHighConfidence,\n  auditFlag,\n  requiresAudit,\n  transactionId,\n  transactionDate,\n  vendorName,\n  amount,\n  rawDescription,\n  currentLabel,\n  rowNumber\n};"
      },
